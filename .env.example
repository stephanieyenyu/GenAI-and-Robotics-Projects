# This repository has no runtime and no secrets of its own. Nothing here reads this file at
# execution time. It records the credentials and hosts a reader needs in order to obtain the
# models and datasets the notebooks depend on, because none of that data is vendored here.

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------

# Hugging Face access token, read scope only. Required by HW7 and HW8 to download gated
# model weights. Set this as a Colab secret named HF_TOKEN and read it with
# google.colab.userdata — do not assign it inside a notebook cell.
HF_TOKEN=

# Weights and Biases API key. HW7 contains an optional logging path guarded by USE_WANDB.
# Leave empty to run without logging.
WANDB_API_KEY=

# ---------------------------------------------------------------------------
# Data hosts — not credentials, recorded because none is under the author's control
# ---------------------------------------------------------------------------

# HW2 queries and novel full text, HW8 GSM8K splits and the AILuminate test set
COURSE_DATA_HOST=https://www.csie.ntu.edu.tw/~b10902031/

# HW5 Steam metadata splits
HW5_DATA_REPO=https://github.com/murphy-cthsu/GENAI-ML-2025-HW5-Data.git

# HW7 preference dataset
HW7_DATA_REPO=https://github.com/jaxon3062/GenAI-2025-HW7-Dataset.git

# ---------------------------------------------------------------------------
# Model identifiers, for reference — no credential needed beyond HF_TOKEN
# ---------------------------------------------------------------------------
# HW2 generator      unsloth/gemma-3-4b-it
# HW2 encoder        intfloat/multilingual-e5-large
# HW5 encoder        all-mpnet-base-v2
# HW7 base           jaxon3062/gemma-3-4b-pt-chat
# HW8 base           unsloth/Llama-3.2-1B-Instruct
